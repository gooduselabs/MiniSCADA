{ "group": "logic-quality", "cases": [
  { "name": "hw-and-lazy-false", "expr": "A && B", "target": "BOOL", "inputs": { "A": false, "B": { "type": "BOOL", "value": null, "quality": "BAD", "reason": "DISCONNECTED" } }, "expect": { "value": false, "quality": "GOOD" } },
  { "name": "hw-or-lazy-true", "expr": "A || B", "target": "BOOL", "inputs": { "A": true, "B": { "type": "BOOL", "value": null, "quality": "BAD", "reason": "DISCONNECTED" } }, "expect": { "value": true, "quality": "GOOD" } },
  { "name": "hw-and-true-then-bad", "expr": "A && B", "target": "BOOL", "inputs": { "A": true, "B": { "type": "BOOL", "value": null, "quality": "BAD", "reason": "DISCONNECTED" } }, "expect": { "value": null, "quality": "BAD", "reason": "INPUT_BAD" } },
  { "name": "hw-and-lazy-skips-uncertain", "expr": "A && B", "target": "BOOL", "inputs": { "A": false, "B": { "type": "BOOL", "value": true, "quality": "UNCERTAIN", "reason": "CLAMPED" } }, "expect": { "value": false, "quality": "GOOD" } },
  { "name": "hw-or-false-then-uncertain", "expr": "A || B", "target": "BOOL", "inputs": { "A": false, "B": { "type": "BOOL", "value": true, "quality": "UNCERTAIN", "reason": "CLAMPED" } }, "expect": { "value": true, "quality": "UNCERTAIN", "reason": "CLAMPED" } },
  { "name": "hw-no-value-reason", "expr": "A + 1", "inputs": { "A": { "type": "FLOAT64", "value": null, "quality": "BAD", "reason": "NO_VALUE" } }, "expect": { "value": null, "quality": "BAD", "reason": "NO_VALUE" } },
  { "name": "hw-input-bad-reason", "expr": "A + 1", "inputs": { "A": { "type": "FLOAT64", "value": null, "quality": "BAD", "reason": "TIMEOUT" } }, "expect": { "value": null, "quality": "BAD", "reason": "INPUT_BAD" } },
  { "name": "hw-uncertain-keeps-reason", "expr": "A * 2", "inputs": { "A": { "type": "FLOAT64", "value": 5, "quality": "UNCERTAIN", "reason": "CLAMPED" } }, "expect": { "value": 10, "quality": "UNCERTAIN", "reason": "CLAMPED" } },
  { "name": "hw-uncertain-first-reason-wins", "expr": "A + B", "inputs": { "A": { "type": "FLOAT64", "value": 1, "quality": "UNCERTAIN", "reason": "RETAIN_LOST" }, "B": { "type": "FLOAT64", "value": 2, "quality": "UNCERTAIN", "reason": "CLAMPED" } }, "expect": { "value": 3, "quality": "UNCERTAIN", "reason": "RETAIN_LOST" } },
  { "name": "hw-bad-stops-before-div-zero", "expr": "A + 1 / 0", "inputs": { "A": { "type": "FLOAT64", "value": null, "quality": "BAD", "reason": "TIMEOUT" } }, "expect": { "value": null, "quality": "BAD", "reason": "INPUT_BAD" } },
  { "name": "hw-div-zero-before-bad-input", "expr": "1 / 0 + A", "inputs": { "A": { "type": "FLOAT64", "value": null, "quality": "BAD", "reason": "TIMEOUT" } }, "expect": { "value": null, "quality": "BAD", "reason": "DIV_ZERO" } },
  { "name": "hw-no-value-second-after-uncertain", "expr": "A + B", "inputs": { "A": { "type": "FLOAT64", "value": 1, "quality": "UNCERTAIN", "reason": "CLAMPED" }, "B": { "type": "FLOAT64", "value": null, "quality": "BAD", "reason": "NO_VALUE" } }, "expect": { "value": null, "quality": "BAD", "reason": "NO_VALUE" } },
  { "name": "hw-run-not-fault", "expr": "PUMP01.RUN && !PUMP01.FAULT", "target": "BOOL", "inputs": { "PUMP01.RUN": true, "PUMP01.FAULT": false }, "expect": { "value": true, "quality": "GOOD" } },
  { "name": "hw-and-with-number-error", "expr": "A && B", "target": "BOOL", "inputs": { "A": 1, "B": true }, "expect": { "error": "E_EXPR_TYPE", "span": [0, 1] } }
] }
