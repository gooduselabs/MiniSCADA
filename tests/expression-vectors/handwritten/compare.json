{ "group": "compare", "cases": [
  { "name": "hw-cmp-neg-zero-eq-zero", "expr": "-0 == 0", "target": "BOOL", "expect": { "value": true, "quality": "GOOD" } },
  { "name": "hw-cmp-neg-zero-lt-zero", "expr": "-0 < 0", "target": "BOOL", "expect": { "value": false, "quality": "GOOD" } },
  { "name": "hw-cmp-ne-same", "expr": "1 != 1", "target": "BOOL", "expect": { "value": false, "quality": "GOOD" } },
  { "name": "hw-cmp-high-level", "expr": "TANK01.LEVEL > TANK01.SP_HI", "inputs": { "TANK01.LEVEL": 91.5, "TANK01.SP_HI": 85 }, "target": "BOOL", "expect": { "value": true, "quality": "GOOD" } },
  { "name": "hw-cmp-chain-error", "expr": "A < B < C", "inputs": { "A": 1, "B": 2, "C": 3 }, "target": "BOOL", "expect": { "error": "E_EXPR_SYNTAX", "span": [6, 7] } },
  { "name": "hw-cmp-chain-eq-error", "expr": "A == B == C", "inputs": { "A": 1, "B": 1, "C": 1 }, "target": "BOOL", "expect": { "error": "E_EXPR_SYNTAX", "span": [7, 9] } }
] }
