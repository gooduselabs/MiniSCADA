  { "name": "hw-assign-int64-decimal-string", "expr": "X", "target": "INT64", "inputs": { "X": { "type": "INT64", "value": "9007199254740993", "quality": "GOOD" } }, "expect": { "value": "9007199254740992", "quality": "GOOD", "warnings": ["W_EXPR_INT64"] } },
  { "name": "hw-assign-uint64-max-double", "expr": "X", "target": "UINT64", "inputs": { "X": 18446744073709551615 }, "expect": { "value": null, "quality": "BAD", "reason": "OUT_OF_RANGE" } },
  { "name": "hw-assign-float32-rounds", "expr": "X", "target": "FLOAT32", "inputs": { "X": 0.1 }, "expect": { "value": 0.10000000149011612, "quality": "GOOD" } },
  { "name": "hw-assign-float32-overflow", "expr": "X", "target": "FLOAT32", "inputs": { "X": 1e39 }, "expect": { "value": null, "quality": "BAD", "reason": "OVERFLOW" } },
