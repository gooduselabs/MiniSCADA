  { "name": "hw-fn-arity-abs", "expr": "abs(A, B)", "inputs": { "A": 1, "B": 2 }, "expect": { "error": "E_EXPR_ARITY", "span": [0, 9] } },
  { "name": "hw-fn-arity-min", "expr": "min(A)", "inputs": { "A": 1 }, "expect": { "error": "E_EXPR_ARITY", "span": [0, 6] } },
