  { "name": "hw-fn-round-n-not-literal", "expr": "round(A, B)", "inputs": { "A": 1, "B": 2 }, "expect": { "error": "E_EXPR_TYPE", "span": [9, 10] } },
  { "name": "hw-fn-arity-nested-outer-first", "expr": "min(abs(1, 2))", "expect": { "error": "E_EXPR_ARITY", "span": [0, 14] } },
  { "name": "hw-fn-round-avg", "expr": "round((FLOW_A + FLOW_B) / 2, 1)", "inputs": { "FLOW_A": 10, "FLOW_B": 11.1 }, "expect": { "value": 10.6, "quality": "GOOD" } }
] }
