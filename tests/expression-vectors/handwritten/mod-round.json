{ "group": "mod-round", "cases": [
  { "name": "hw-round-2.5", "expr": "round(2.5)", "expect": { "value": 3, "quality": "GOOD" } },
  { "name": "hw-round-neg-2.5", "expr": "round(-2.5)", "expect": { "value": -3, "quality": "GOOD" } },
  { "name": "hw-round-0.5", "expr": "round(0.5)", "expect": { "value": 1, "quality": "GOOD" } },
  { "name": "hw-round-neg-0.5", "expr": "round(-0.5)", "expect": { "value": -1, "quality": "GOOD" } },
  { "name": "hw-round-just-below-half", "expr": "round(0.49999999999999994)", "expect": { "value": 0, "quality": "GOOD" } },
  { "name": "hw-round-large-half", "expr": "round(4503599627370495.5)", "expect": { "value": 4503599627370496, "quality": "GOOD" } },
  { "name": "hw-round-neg-small-is-zero", "expr": "round(-0.4)", "expect": { "value": 0, "quality": "GOOD" } },
  { "name": "hw-round-1.005-2", "expr": "round(1.005, 2)", "expect": { "value": 1, "quality": "GOOD" } },
  { "name": "hw-round-2.675-2", "expr": "round(2.675, 2)", "expect": { "value": 2.68, "quality": "GOOD" } },
  { "name": "hw-round-123.456-1", "expr": "round(123.456, 1)", "expect": { "value": 123.5, "quality": "GOOD" } },
  { "name": "hw-round-mod-div", "expr": "round(10 % 3 / 7, 3)", "expect": { "value": 0.143, "quality": "GOOD" } },
  { "name": "hw-mod-neg-dividend", "expr": "-7 % 3", "expect": { "value": -1, "quality": "GOOD" } },
  { "name": "hw-mod-neg-divisor", "expr": "7 % -3", "expect": { "value": 1, "quality": "GOOD" } },
  { "name": "hw-mod-fraction", "expr": "5.5 % 2", "expect": { "value": 1.5, "quality": "GOOD" } },
  { "name": "hw-div-zero", "expr": "1 / 0", "expect": { "value": null, "quality": "BAD", "reason": "DIV_ZERO" } },
  { "name": "hw-div-neg-zero", "expr": "1 / -0", "expect": { "value": null, "quality": "BAD", "reason": "DIV_ZERO" } },
  { "name": "hw-div-zero-by-zero", "expr": "0 / 0", "expect": { "value": null, "quality": "BAD", "reason": "DIV_ZERO" } },
  { "name": "hw-mod-zero", "expr": "1 % 0", "expect": { "value": null, "quality": "BAD", "reason": "MOD_ZERO" } },
  { "name": "hw-mod-neg-zero", "expr": "5 % -0", "expect": { "value": null, "quality": "BAD", "reason": "MOD_ZERO" } },
  { "name": "hw-overflow-pos", "expr": "1e308 * 10", "expect": { "value": null, "quality": "BAD", "reason": "OVERFLOW" } },
  { "name": "hw-overflow-neg", "expr": "-1e308 * 10", "expect": { "value": null, "quality": "BAD", "reason": "OVERFLOW" } },
  { "name": "hw-nan-input-arith", "expr": "A + 1", "inputs": { "A": { "type": "FLOAT64", "value": "NaN", "quality": "GOOD" } }, "expect": { "value": null, "quality": "BAD", "reason": "NOT_A_NUMBER" } },
  { "name": "hw-nan-input-assign", "expr": "A", "inputs": { "A": { "type": "FLOAT64", "value": "NaN", "quality": "GOOD" } }, "expect": { "value": null, "quality": "BAD", "reason": "NOT_A_NUMBER" } },
  { "name": "hw-infinity-input", "expr": "A * 2", "inputs": { "A": { "type": "FLOAT64", "value": "Infinity", "quality": "GOOD" } }, "expect": { "value": null, "quality": "BAD", "reason": "OVERFLOW" } }
] }
