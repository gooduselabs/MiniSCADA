{
  "schemaVersion": "1.1.0",
  "id": "bom-chi-tiet",
  "name": "Chi tiết bơm",
  "kind": "popup",
  "size": {
    "width": 640,
    "height": 420
  },
  "params": [
    {
      "name": "prefix",
      "kind": "tagPrefix"
    },
    {
      "name": "title",
      "kind": "string",
      "default": "Bơm"
    }
  ],
  "items": [
    {
      "id": "panel_f",
      "type": "widget",
      "widget": "panel",
      "props": {
        "title": "{title}"
      }
    },
    {
      "id": "flow_f",
      "type": "widget",
      "widget": "card",
      "props": {
        "label": "Lưu lượng {title}"
      },
      "tags": {
        "value": "{prefix}.FLOW"
      }
    },
    {
      "id": "run_f",
      "type": "widget",
      "widget": "switch",
      "props": {
        "label": "{title}"
      },
      "tags": {
        "target": "{prefix}.RUN_CMD"
      }
    },
    {
      "id": "close_f",
      "type": "widget",
      "widget": "button",
      "props": {
        "label": "Đóng",
        "variant": "neutral"
      },
      "events": {
        "click": {
          "action": "closePopup"
        }
      }
    }
  ],
  "layout": {
    "mode": "grid",
    "columns": 12,
    "rows": [
      {
        "id": "r1",
        "height": "auto",
        "cells": [
          {
            "id": "c1",
            "span": 3,
            "item": "panel_f"
          },
          {
            "id": "c2",
            "span": 3,
            "item": "flow_f"
          },
          {
            "id": "c3",
            "span": 3,
            "item": "run_f"
          },
          {
            "id": "c4",
            "span": 3,
            "item": "close_f"
          }
        ]
      }
    ]
  }
}
