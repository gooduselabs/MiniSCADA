{
  "schemaVersion": "0.1.0",
  "groups": [
    {
      "id": "fast",
      "name": "Fast",
      "mode": "onChange",
      "minIntervalMs": 1000,
      "retentionDays": 7,
      "tags": [
        {
          "tagId": "T.LEVEL",
          "deadband": 0.5
        },
        {
          "tagId": "T.RUN",
          "column": "_value"
        },
        {
          "tagId": "T.NAME",
          "maxLength": 32
        }
      ]
    },
    {
      "id": "shift",
      "name": "Shift",
      "mode": "cyclic",
      "periodMs": 60000,
      "retentionDays": 365,
      "tags": [
        {
          "tagId": "T.LEVEL",
          "column": "LEVEL"
        }
      ]
    }
  ]
}
