        "address": "HR12.3"
      }
    },
    {
      "id": "PUMP01.NAME",
      "kind": "external",
      "type": "STRING",
      "source": {
        "device": "plc1",
        "address": "HR300",
        "stringLength": 16
      }
    },
    {
      "id": "TANK01.SP_HI",
      "kind": "internal",
      "type": "FLOAT32",
      "unit": "%",
      "access": "RW",
      "limits": {
        "min": 0,
        "max": 100
      },
      "initial": 85,
      "retain": true
    },
    {
      "id": "TANK01.VOLUME",
      "kind": "calculated",
      "type": "FLOAT32",
      "unit": "m3",
      "expression": "TANK01.LEVEL * 12.5"
    },
    {
      "id": "TANK01.HIGH",
      "kind": "calculated",
      "type": "BOOL",
      "expression": "TANK01.LEVEL > TANK01.SP_HI"
    },
    {
      "id": "PUMP01.STATE_TEXT",
      "kind": "calculated",
      "type": "STRING",
      "expression": "text(PUMP01.STATE, TrangThaiBom)"
    },
