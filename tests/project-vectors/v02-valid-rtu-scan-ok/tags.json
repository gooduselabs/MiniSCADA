      "access": "RW",
      "source": {
        "device": "plc1",
        "address": "C10",
        "readback": false
      }
    },
    {
      "id": "PUMP01.STATE",
      "kind": "external",
      "type": "INT16",
      "valueTable": "TrangThaiBom",
      "source": {
        "device": "plc1",
        "address": "HR10"
      }
    },
    {
      "id": "METER1.P",
      "kind": "external",
