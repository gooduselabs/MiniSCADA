{
  "schemaVersion": "0.2.0",
  "tags": [
    {
      "id": "TANK01.LEVEL",
      "kind": "external",
      "type": "FLOAT32",
      "description": "Mức nước bồn",
      "unit": "%",
      "min": 0,
      "max": 100,
      "deadband": 0.5,
      "source": {
        "device": "plc1",
        "address": "HR100",
        "rawType": "INT16"
      },
      "scaling": {
        "rawMin": 0,
        "rawMax": 27648,
        "engMin": 0,
        "engMax": 100,
        "clamp": true
      }
    },
    {
