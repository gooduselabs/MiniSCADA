{
  "schemaVersion": "1.1.0",
  "scanGroups": {
    "fast": 250,
    "normal": 1000,
    "slow": 5000
  },
  "channels": [
    {
      "id": "plc1",
      "name": "PLC trạm bơm",
      "kind": "modbus-tcp",
      "tcp": {
        "host": "192.168.10.5",
        "port": 502
      },
      "devices": [
        {
          "id": "plc1",
          "name": "PLC trạm bơm",
          "unitId": 1,
          "byteOrder": "ABCD",
          "write": {
            "registerBit": "mask"
          }
        }
      ]
    },
    {
      "id": "rs485-1",
      "name": "RS485 đồng hồ điện",
      "kind": "modbus-rtu",
      "serial": {
        "port": "ttyAS2",
        "baud": 9600,
        "dataBits": 8,
        "parity": "even",
        "stopBits": 1,
        "rs485": true
      },
      "devices": [
        {
          "id": "meter1",
          "name": "Đồng hồ 1",
          "slave": 1,
          "addressBase": 1,
          "timeoutMs": 400
        },
        {
          "id": "meter2",
          "name": "Đồng hồ 2",
          "slave": 2,
          "addressBase": 1,
          "enabled": false
        }
      ]
    },
    {
      "id": "mq-1",
      "name": "Broker MQTT",
      "kind": "mqtt",
      "mqtt": {
        "host": "broker.plant.local",
        "port": 8883,
        "clientId": "mat-site-7",
        "keepAliveS": 60,
        "cleanSession": false,
        "tls": {
          "enabled": true,
          "serverCertSha256": "5d2f7a91c3e8b0461f5d2f7a91c3e8b0461f5d2f7a91c3e8b0461f5d2f7a91c3",
          "serverName": "broker.plant.local"
        },
        "auth": {
          "username": "site7",
          "secretId": "mqtt-mq-1"
        },
        "will": {
          "topic": "mat/site7/status",
          "payload": "offline",
          "qos": 1,
          "retain": true
        },
        "maxPublishPerS": 50,
        "publishGroups": [
          {
            "topic": "mat/site7/state",
            "tags": [
              "MQ.LEVEL",
              "MQ.RUN"
            ],
            "intervalMs": 5000,
            "qos": 1
          },
          {
            "topic": "mat/site7/changes",
            "tags": [
              "MQ.TEMP"
            ],
            "onChange": true,
            "retain": true
          }
        ],
        "connectTimeoutMs": 3000,
        "reconnectMaxS": 30
      },
      "devices": [
        {
          "id": "broker1",
          "name": "Broker",
          "timeoutMs": 3000,
          "writeDeadlineMs": 8000,
          "staleAfterMs": 60000
        }
      ]
    }
  ]
}
