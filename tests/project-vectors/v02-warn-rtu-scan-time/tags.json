{
  "schemaVersion": "0.2.0",
  "tags": [
    {
      "id": "TANK01.LEVEL",
      "kind": "external",
      "type": "FLOAT32",
      "description": "Mức nước bồn",
      "unit": "%",
      "min": 0,
      "max": 100,
      "deadband": 0.5,
      "source": {
        "device": "plc1",
        "address": "HR100",
        "rawType": "INT16"
      },
      "scaling": {
        "rawMin": 0,
        "rawMax": 27648,
        "engMin": 0,
        "engMax": 100,
        "clamp": true
      }
    },
    {
      "id": "TANK01.SP",
      "kind": "external",
      "type": "FLOAT32",
      "unit": "%",
      "access": "RW",
      "limits": {
        "min": 0,
        "max": 90
      },
      "source": {
        "device": "plc1",
        "address": "HR200",
        "byteOrder": "CDAB"
      }
    },
    {
      "id": "PUMP01.RUN_CMD",
      "kind": "external",
      "type": "BOOL",
      "access": "RW",
      "source": {
        "device": "plc1",
        "address": "C10",
        "readback": false
      }
    },
    {
      "id": "PUMP01.STATE",
      "kind": "external",
      "type": "INT16",
      "valueTable": "TrangThaiBom",
      "source": {
        "device": "plc1",
        "address": "HR10"
      }
    },
    {
      "id": "METER1.P",
      "kind": "external",
      "type": "FLOAT32",
      "unit": "kW",
      "source": {
        "device": "meter1",
        "address": "30013"
      }
    },
    {
      "id": "PUMP01.FAULT",
      "kind": "external",
