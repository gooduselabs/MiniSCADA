{
  "schemaVersion": "0.1.0",
  "screenId": "main",
  "elements": [
    {
      "elementUid": "el_aaa",
      "bindings": [
        {
          "id": "b1",
          "target": "geometry.levelPercent",
          "source": {
            "type": "tag",
            "tagId": "T.LEVEL"
          },
          "transform": {
            "kind": "direct"
          }
        }
      ]
    },
    {
      "elementUid": "el_bbb",
      "bindings": [
        {
          "id": "b2",
          "target": "style.fill",
          "source": {
            "type": "tag",
            "tagId": "T.RUN"
          },
          "transform": {
            "kind": "discreteMap",
            "cases": [
              {
                "equals": true,
                "value": "#22c55e"
              },
              {
                "equals": false,
                "value": "#64748b"
              }
            ]
          }
        }
      ]
    },
    {
      "elementUid": "el_ccc",
      "bindings": [
        {
          "id": "c1",
          "target": "text.content",
          "source": {
            "type": "tag",
            "tagId": "T.LEVEL"
          },
          "transform": {
            "kind": "direct"
          },
          "format": {
            "decimals": 1,
            "suffix": " %"
          }
        },
        {
          "id": "c2",
          "target": "style.opacity",
          "source": {
            "type": "tag",
            "tagId": "T.LEVEL"
          },
          "transform": {
            "kind": "linearScale",
            "inMin": 0,
            "inMax": 100,
            "outMin": 0.2,
            "outMax": 1,
            "clamp": true
          }
        },
        {
          "id": "c3",
          "target": "style.visibility",
          "source": {
            "type": "tag",
            "tagId": "T.RUN"
          },
          "transform": {
            "kind": "direct"
          }
        },
        {
          "id": "c4",
          "target": "style.stroke",
          "source": {
            "type": "tag",
            "tagId": "T.NAME"
          },
          "transform": {
            "kind": "direct"
          },
          "onBadQuality": {
            "mode": "override",
            "value": "#8d99a3"
          }
        },
        {
          "id": "c5",
          "target": "transform.rotate",
          "source": {
            "type": "tag",
            "tagId": "T.RUN"
          },
          "transform": {
            "kind": "direct"
          },
          "animation": "spin"
        },
        {
          "id": "c6",
          "target": "transform.rotate",
          "source": {
            "type": "tag",
            "tagId": "T.LEVEL"
          },
          "transform": {
            "kind": "linearScale",
            "inMin": 0,
            "inMax": 100,
            "outMin": 0,
            "outMax": 270
          }
        },
        {
          "id": "c7",
          "target": "style.fill",
          "source": {
            "type": "tag",
            "tagId": "T.LEVEL"
          },
          "transform": {
            "kind": "discreteMap",
            "cases": [
              {
                "equals": 0,
                "value": "#000000"
              }
            ],
            "default": "#ffffff"
          },
          "onBadQuality": {
            "mode": "hold"
          }
        }
      ]
    }
  ]
}
