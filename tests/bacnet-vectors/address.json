      "name": "AI mặc định present-value",
      "address": "AI:1",
      "rawType": "FLOAT32",
      "access": "R",
      "expect": {
        "objectType": "AI",
        "instance": 1,
        "property": 85,
        "priority": 0,
        "relinquish": false,
        "normalized": "AI:1"
      }
    },
    {
      "name": "chữ thường và thuộc tính viết rõ",
      "address": "av:5:present-value",
