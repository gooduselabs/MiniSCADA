{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/recipes/1.0.json",
  "title": "mAT SCADA recipes (format 1.1)",
  "description": "Feature 024 (specs/024-recipes/plan.md, Hợp đồng): loại recipe (Tag tham số có giới hạn) và bản recipe (giá trị từng tham số). Khai bởi recipesFile của project.json 1.1. Luật liên file E_RECIPE_* do bộ kiểm tra TS và C++ kiểm, không ở đây.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "types"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "types": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/type"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "tagId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "params", "recipes"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view": {
              "enum": ["viewer", "operator", "engineer", "administrator"]
            },
            "operate": {
              "enum": ["operator", "engineer", "administrator"]
            },
            "edit": {
              "enum": ["operator", "engineer", "administrator"]
            }
          }
        },
        "params": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/param"
          }
        },
        "recipes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/recipe"
          }
        }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagId"],
      "properties": {
        "tagId": {
          "$ref": "#/definitions/tagId"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "maxLength": 16
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "values"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "values": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": ["number", "boolean", "string"],
            "maxLength": 256
          }
        }
      }
    }
  }
}
