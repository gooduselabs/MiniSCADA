{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/watch-table/0.3.json",
  "title": "mAT SCADA watch table (schema 0.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "rows"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "rows": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag"],
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
          },
          "format": {
            "enum": ["auto", "dec", "hex", "bin", "bool"]
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "writeValue": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}
