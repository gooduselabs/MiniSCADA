{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/logging/0.1.json",
  "title": "mAT SCADA tag logging (schema v0)",
  "description": "specs/003-data-logging/data-model.md §1. Cross-file rules (E_LOG_*) are checked by the validators, not here. No secrets: passwords/tokens live on the device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": {
      "$ref": "#/definitions/semver"
    },
    "timeZone": {
      "$ref": "#/definitions/utcOffset"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/group"
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/connection"
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "utcOffset": {
      "type": "string",
      "pattern": "^(\\+(0\\d|1[0-3]):[0-5]\\d|\\+14:00|-(0\\d|1[01]):[0-5]\\d|-12:00)$"
    },
    "interval": {
      "type": "integer",
      "minimum": 100,
      "maximum": 86400000
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "retentionDays", "tags"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "mode": {
          "enum": ["cyclic", "onChange"]
        },
        "periodMs": {
          "$ref": "#/definitions/interval"
        },
        "minIntervalMs": {
          "$ref": "#/definitions/interval"
        },
        "maxIntervalMs": {
          "$ref": "#/definitions/interval"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "destinations": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/loggedTag"
          }
        }
      }
    },
    "loggedTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagId"],
      "properties": {
        "tagId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        },
        "column": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "deadband": {
          "type": "number",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": ["mysql", "mssql", "postgresql", "influxdb"]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_$.-]{0,63}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        },
        "url": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?://([A-Za-z0-9.-]+|\\[[0-9A-Fa-f:]+\\])(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$"
        },
        "org": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "tls": {
          "enum": ["disable", "prefer", "require", "verify-full"]
        },
        "timeZone": {
          "$ref": "#/definitions/utcOffset"
        }
      }
    }
  }
}
