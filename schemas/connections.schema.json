{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/connections/1.0.json",
  "title": "mAT SCADA connections: channels and field devices (schema 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channels"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "scanGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fast": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "normal": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "slow": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "channels": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/definitions/channel"
      }
    }
  },
  "definitions": {
    "channel": {
      "oneOf": [
        {
          "$ref": "#/definitions/tcpChannel"
        },
        {
          "$ref": "#/definitions/rtuChannel"
        },
        {
          "$ref": "#/definitions/s7Channel"
        },
        {
          "$ref": "#/definitions/finsChannel"
        },
        {
          "$ref": "#/definitions/mcChannel"
        },
        {
          "$ref": "#/definitions/bacnetChannel"
        },
        {
          "$ref": "#/definitions/opcuaChannel"
        },
        {
          "$ref": "#/definitions/mqttChannel"
        }
      ]
    },
    "s7Channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "tcp", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "requestGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kind": {
          "const": "s7"
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "s7": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rack": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "localTsap": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{4}$"
            },
            "remoteTsap": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{4}$"
            },
            "pduSize": {
              "type": "integer",
              "minimum": 240,
              "maximum": 960
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/s7Device"
          }
        }
      }
    },
    "s7Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "writeDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "maxGapBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "finsChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "fins", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "requestGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kind": {
          "const": "fins"
        },
        "fins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "transport": {
              "enum": ["udp", "tcp"]
            },
            "sourceNetwork": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "sourceNode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 254
            },
            "localPort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/finsDevice"
          }
        }
      }
    },
    "finsDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "network": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254
        },
        "unit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "writeDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "maxReadWords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "maxGapWords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "multiRead": {
          "type": "boolean"
        },
        "maxMultiItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "byteOrder": {
          "enum": ["ABCD", "CDAB", "BADC", "DCBA"]
        }
      }
    },
    "bacnetChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "requestGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kind": {
          "const": "bacnet"
        },
        "bacnet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "localPort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "bindAddress": {
              "type": "string",
              "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
            },
            "broadcast": {
              "type": "string",
              "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
            },
            "bbmd": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host"],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[^\\s/\\\\]+$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "ttlS": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 65535
                }
              }
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/bacnetDevice"
          }
        }
      }
    },
    "bacnetDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "deviceInstance", "host"],
      "dependencies": {
        "mac": ["network"]
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "deviceInstance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194302
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[^\\s/\\\\]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "network": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65534
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}){1,6}$"
        },
        "maxApdu": {
          "type": "integer",
          "minimum": 50,
          "maximum": 1476
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "writeDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "writePriority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "not": {
            "const": 6
          }
        },
        "useRpm": {
          "type": "boolean"
        },
        "maxRpmProps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "opcuaChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "opcua", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "const": "opcua"
        },
        "opcua": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpointUrl"],
          "properties": {
            "endpointUrl": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^opc\\.tcp://[^\\s/:]+(:[0-9]{1,5})?(/\\S*)?$"
            },
            "securityMode": {
              "enum": ["None", "Sign", "SignAndEncrypt"]
            },
            "securityPolicy": {
              "enum": ["None", "Basic256Sha256"]
            },
            "serverCertSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": {
                  "enum": ["anonymous", "username"]
                },
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "secretId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                }
              }
            },
            "readMode": {
              "enum": ["subscription", "poll"]
            },
            "sessionTimeoutMs": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 3600000
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/opcuaDevice"
          }
        }
      }
    },
    "opcuaDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "writeDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        }
      }
    },
    "mqttChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "mqtt", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "const": "mqtt"
        },
        "mqtt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9.:_-]+$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "clientId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "keepAliveS": {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            },
            "cleanSession": {
              "type": "boolean"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "serverCertSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "caCertPem": {
                  "type": "string",
                  "maxLength": 16384,
                  "pattern": "^-----BEGIN CERTIFICATE-----"
                },
                "serverName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              }
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["username", "secretId"],
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "secretId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                }
              }
            },
            "will": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topic"],
              "properties": {
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^#+]+$"
                },
                "payload": {
                  "type": "string",
                  "maxLength": 1024
                },
                "qos": {
                  "enum": [0, 1]
                },
                "retain": {
                  "type": "boolean"
                }
              }
            },
            "maxPublishPerS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "publishGroups": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topic"],
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "required": ["intervalMs"]
                      },
                      {
                        "required": ["onChange"],
                        "properties": {
                          "onChange": {
                            "const": true
                          }
                        }
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "required": ["tags"]
                      },
                      {
                        "required": ["tagPatterns"]
                      }
                    ]
                  }
                ],
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^#+]+$"
                  },
                  "tags": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "tagPatterns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "timestamps": {
                    "type": "boolean"
                  },
                  "intervalMs": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  },
                  "onChange": {
                    "type": "boolean"
                  },
                  "qos": {
                    "enum": [0, 1]
                  },
                  "retain": {
                    "type": "boolean"
                  }
                }
              }
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/mqttDevice"
          }
        }
      }
    },
    "mqttDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "writeDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "staleAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "tcpChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "tcp", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "requestGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kind": {
          "const": "modbus-tcp"
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            },
            "reconnectMaxS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/tcpDevice"
          }
        }
      }
    },
    "rtuChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "serial", "devices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "requestGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kind": {
          "const": "modbus-rtu"
        },
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1,
              "maxLength": 220
            },
            "baud": {
              "enum": [1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200]
            },
            "dataBits": {
              "enum": [7, 8]
            },
            "parity": {
              "enum": ["none", "even", "odd"]
            },
            "stopBits": {
              "enum": [1, 2]
            },
            "rs485": {
              "type": "boolean"
            },
            "dropEcho": {
              "type": "boolean"
            },
            "silenceMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/rtuDevice"
          }
        }
      }
    },
    "tcpDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "enabled": {
