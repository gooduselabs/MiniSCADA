{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/reports/0.6.json",
  "title": "mAT SCADA report templates (schema 0.6)",
  "description": "specs/010-history-reports/contracts/templates-config.md §2. Cross-file rules (E_RPT_*) are checked by the validators, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reports"],
  "properties": {
    "schemaVersion": {
      "$ref": "#/definitions/semver"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/report"
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "period", "columns"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "group": {
          "$ref": "#/definitions/id"
        },
        "period": {
          "enum": ["day", "shift", "month"]
        },
        "rowMinutes": {
          "enum": [15, 30, 60]
        },
        "shifts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "start"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "start": {
              "type": "string",
              "maxLength": 16
            }
          }
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "footer": {
          "type": "string",
          "maxLength": 200
        },
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "enum": ["A4", "A3"]
            },
            "orientation": {
              "enum": ["portrait", "landscape"]
            }
          }
        },
        "totals": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/definitions/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagId", "functions"],
      "properties": {
        "tagId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "maxLength": 16
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "enum": ["min", "max", "avg", "sum", "first", "last", "delta", "count"]
          }
        }
      }
    }
  }
}
