{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.atpro.com.vn/mat/package-manifest/1.0.json",
  "title": "mAT SCADA package manifest matscada.json (format 1.x)",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "formatVersion", "project", "createdAt", "generator", "files", "digest"],
  "properties": {
    "format": {
      "const": "matscada-package"
    },
    "formatVersion": {
      "$ref": "#/definitions/semver"
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["projectId", "projectName", "projectVersion", "minRuntimeVersion"],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "projectName": {
          "type": "string"
        },
        "projectVersion": {
          "type": "string"
        },
        "minRuntimeVersion": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1023,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    }
  }
}
