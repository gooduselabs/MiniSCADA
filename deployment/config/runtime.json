{
  "port": 8080,
  "docroot": "/opt/mat-runtime/web",
  "projectDir": "/opt/mat-runtime/project",
  "schemasDir": "/opt/mat-runtime/schemas",
  "maxClients": 10,
  "allowedOrigins": ["http://tauri.localhost", "tauri://localhost"],
  "deltaPeriodMs": 250,
  "simLoad": true,
  "threads": 24,
  "viewerLogin": "required",
  "webSessionIdleMin": 30,
  "webSessionMaxHours": 12,
  "webMaxSessions": 12,
  "allowedHosts": [],
  "hostCheck": "strict",
  "maxConnPerSource": 48,
  "maxConcurrentLogins": 2,
  "pulseRecovery": "on",
  "update": { "enabled": false, "maxPackageMiB": 64, "trustedKeysDir": "/etc/mat-runtime/trusted-keys" },
  "logic": { "writes": "off", "maxWritesPerMin": 20, "flushS": 60, "scanMs": 100 },
  "tzOffsetMin": 420
}
