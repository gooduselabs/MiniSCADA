[Unit]
Description=mAT SCADA runtime (Sprint 1)
Documentation=file:///opt/mat-runtime/README-deploy.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matscada
Group=matscada
ExecStart=/opt/mat-runtime/bin/mat-runtime --config /etc/mat-runtime/runtime.json
Restart=always
RestartSec=2
# Dữ liệu lưu trữ (feature 003): /var/lib/mat-runtime thuộc matscada, ghi được dù ProtectSystem=strict,
# giữ nguyên qua deploy/rollback (deploy.sh chỉ thay /opt/mat-runtime).
StateDirectory=mat-runtime
StateDirectoryMode=0700
# Phiên đăng nhập đi qua lần execv khi kích hoạt project (feature 005): /run/mat-runtime trên tmpfs,
# thuộc matscada, mất khi dịch vụ dừng hoặc thiết bị khởi động lại.
RuntimeDirectory=mat-runtime
RuntimeDirectoryMode=0700
# Ngân sách tài nguyên (Master Plan §6.1, Constitution III)
MemoryMax=300M
# An toàn mặc định (Constitution V): không đặc quyền, chỉ đọc hệ thống, sandbox systemd
NoNewPrivileges=true
# no core file: it would hold the secrets of the external databases
LimitCORE=0
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Cổng serial (feature 006, T169; đo trên BL335 2026-10-13): cgroup chỉ cho thiết bị giả chuẩn và
# UART của chip (major ttyAS). KHÔNG cho ttyUSB (modem 4G Quectel EC25 trên BL335); ttyAS0 là console
# nên quyền file (root:tty 0620) vẫn chặn matscada. Bộ chuyển USB-RS485: thêm drop-in riêng.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-ttyAS rw
SupplementaryGroups=dialout
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
ReadOnlyPaths=/opt/mat-runtime /etc/mat-runtime

[Install]
WantedBy=multi-user.target
