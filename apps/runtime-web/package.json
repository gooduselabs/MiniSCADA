    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mat/binding-engine": "*",
    "@mat/expression": "*",
    "@mat/history-math": "*",
    "@mat/live-client": "*",
    "@mat/project-schema": "*",
    "@mat/report-export": "*",
    "@mat/svg-renderer": "*",
    "@mat/ui-components": "*"
  }
}
